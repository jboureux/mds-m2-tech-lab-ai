FROM node:22-bookworm-slim AS base

# Install pnpm and prepare the correct version
RUN corepack enable && corepack prepare pnpm@10.6.4 --activate

# Install system dependencies for native modules (like TensorFlow and Sharp)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    ca-certificates \
    libvips-dev \
    && rm -rf /var/lib/apt/lists/*

FROM base AS deps
WORKDIR /app

# Copy files required to install dependencies
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json ./apps/web/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build the application
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY . .

# Generate Prisma Client before building
RUN pnpm --filter web exec prisma generate

# Disable telemetry during build if preferred
# ENV NEXT_TELEMETRY_DISABLED=1

RUN pnpm --filter web build

# Production image, copy all the files and run next
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
# ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Install prisma CLI globally in the runner for migrations
RUN npm install -g prisma@7.4.0

# Copy prisma files for migrations
COPY --from=builder /app/apps/web/prisma ./apps/web/prisma

COPY --from=builder /app/apps/web/public ./apps/web/public

# Leverage output traces to reduce image size (Next.js standalone mode)
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

# Copy and setup production entrypoint
COPY docker/prod-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Configure shared library path for TensorFlow
RUN mkdir -p /etc/ld.so.conf.d && \
    echo "/app/node_modules/@tensorflow/tfjs-node/deps/lib" > /etc/ld.so.conf.d/tensorflow.conf && \
    ldconfig

# Use the entrypoint
ENTRYPOINT ["entrypoint.sh"]

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# The standalone build puts the server entry point at apps/web/server.js
CMD ["node", "apps/web/server.js"]
